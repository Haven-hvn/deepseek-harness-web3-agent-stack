{
  "name": "dsh-arkiv",
  "description": "Arkiv entity storage for DeepSeek Harness: ctx.arkiv (create/query via @arkiv-network/sdk) — gated Filecoin-style, haven-spec entity definition",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types.d.ts", "default": "./lib/types.js" },
    "./arkiv": { "types": "./lib/arkiv.d.ts", "default": "./lib/arkiv.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib", "src", "cordis.patch.yml"],
  "license": "MIT",
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": { "build": "tsdown", "prepare": "tsdown" },
  "dependencies": {
    "@deepseek-ai/schemastery": "==3.18.1",
    "@arkiv-network/sdk": "==0.4.0",
    "viem": "==2.53.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "dsh-wallet": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "==4.0.1",
    "@deepseek-ai/dsh-tools": "==0.1.0-rc.7",
    "dsh-wallet": "workspace:==0.1.0",
    "tsdown": "==0.22.14",
    "typescript": "==7.0.2",
    "vitest": "==4.1.11"
  }
}
