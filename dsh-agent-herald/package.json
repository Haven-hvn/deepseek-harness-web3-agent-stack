{
  "name": "dsh-agent-herald",
  "description": "Herald, the sovereign release agent: soul.md + process.md + Haven-AOL protocol reference registered as system-prompt sections — a publisher that earns its keep releasing ownership-gated files to DataDAO communities",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./soul.md": "./soul.md",
    "./process.md": "./process.md",
    "./reference/*": "./reference/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "soul.md",
    "process.md",
    "reference",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "=3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "=4.0.4",
    "@deepseek-ai/dsh-system-prompt": "=0.1.7-rc.2",
    "tsdown": "=0.23.0",
    "typescript": "=7.0.2",
    "vitest": "=5.0.2"
  }
}
