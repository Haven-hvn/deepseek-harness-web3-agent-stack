{
  "name": "dsh-haven-aol",
  "description": "Haven-AOL token-gated decryption for DeepSeek Harness: ctx.aol (aol_decrypt v1/v3/v4 + aol_gate_info + aol_epoch + aol_market_cap over haven-aol TS SDK + ICP canister) \u2014 raw EIP-712 digest signing via ctx.wallet",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./aol": {
      "types": "./lib/aol.d.ts",
      "default": "./lib/aol.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "haven-aol": "file:../../haven-aol/packages/typescript",
    "@icp-sdk/core": "6.1.2",
    "@icp-sdk/vetkeys": "0.7.0",
    "ethers": "6.17.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "dsh-wallet": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@open-wallet-standard/core": "1.4.5",
    "dsh-wallet": "workspace:=0.1.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
