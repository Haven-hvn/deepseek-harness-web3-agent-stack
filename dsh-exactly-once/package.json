{
  "name": "dsh-exactly-once",
  "description": "Transparent exactly-once guard for DeepSeek Harness write tools: a tools/execute wrapper that dedups redelivered calls by (agent, callId), replays settled results from the session ledger, and checks repeats-after-ambiguous outcomes against per-tool read-back hooks — model-invisible, no new tools or parameters",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "=0.2.1-alpha.1",
    "tsdown": "=0.23.0",
    "typescript": "=7.0.2",
    "vitest": "=5.0.2"
  }
}
