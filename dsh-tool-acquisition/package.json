{
  "name": "dsh-tool-acquisition",
  "description": "Download/acquisition tools for DeepSeek Harness: turn Prowlarr releases, magnets, or direct URLs into local files via qBittorrent/Transmission plus guarded HTTP fetch — the missing arm between prowlarr_search and synapse_pin",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1",
    "dsh-tool-prowlarr": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-launch-environment": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "=0.2.1-alpha.1",
    "@types/node": "=26.6.3",
    "dsh-exactly-once": "workspace:=0.1.0",
    "tsdown": "=0.23.0",
    "typescript": "=7.0.2",
    "vitest": "=5.0.2"
  }
}
