{
  "name": "dsh-wallet-ethereum",
  "description": "Ethereum wallet provider for DeepSeek Harness: dsh-wallet CryptoAdapter in two custody modes - OWS vault (default, EIP-191 only) or raw private key (signDigest for EIP-712 gates such as Haven-AOL)",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./raw": {
      "types": "./lib/raw.d.ts",
      "default": "./lib/raw.js"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "=3.18.2",
    "ethers": "=6.16.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-invariants": "0.1.2-rc.1",
    "@open-wallet-standard/core": "1.4.2",
    "dsh-wallet": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@open-wallet-standard/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "=4.0.2",
    "@deepseek-ai/dsh-credentials": "=0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "=0.1.2-rc.1",
    "dsh-wallet": "workspace:=0.1.0",
    "tsdown": "=0.23.0",
    "typescript": "=7.0.2",
    "vitest": "=5.0.0",
    "ethers": "=6.16.0"
  }
}
