# Single all-in-one GUI agent image: OpenMausBot Web/Desktop/Mobile GUI +
# DeepSeek Harness (`dsh`) + web3 agent stack + Prowlarr, qBittorrent,
# ffmpeg, yt-dlp, and Observatory dashboard (no Transmission, no XMTP).
#
# Built on top of the official multi-arch OpenMausBot server image
# (node:24-bookworm-slim + compiled UI/server + DuckDB + Chrome + tini + bwrap)
# so users on single-container runtimes without docker-compose (e.g. wslc,
# plain docker run, podman run) get the entire stack in one pull.
#
# All state lives in /data. See docker/README.md for run instructions.
# Pin the base by digest so an upstream `:latest` move cannot silently change
# MausBot beneath a released image. Override with --build-arg OMB_IMAGE=... to
# move to a newer verified MausBot (this digest is 0.1.181, verified 2026-11-25).
ARG OMB_IMAGE=ghcr.io/milind-soni/openmausbot@sha256:f1af2655d7a13ad8dea146d342e4ec70c638071fb841ab7a1b3039b16df5ecc3
FROM ${OMB_IMAGE}

USER root

# OpenMausBot's base image sets `NODE_ENV=production` and `HOME=/data`. Switch
# to build-time defaults so `npm ci` / `pnpm install` include devDependencies
# (`tsc`, `tsdown`, `@deepseek-ai/cordis` peers) and nothing writes into `/data`
# before `VOLUME /data`; runtime `ENV` at the bottom restores production values.
ENV HOME=/root \
    NODE_ENV=development \
    DEBIAN_FRONTEND=noninteractive \
    DSH_TELEMETRY_DISABLED=1 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=true

# OS binaries: qBittorrent, media tools, supervision. libicu72 for the
# self-contained Prowlarr build on slim. python3-mutagen writes the ID3
# CHAP/CTOC chapters ffmpeg cannot emit into MP3 (process.md §1 step 2).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git xz-utils \
      libicu72 \
      qbittorrent-nox \
      ffmpeg supervisor \
      python3 python3-pip python3-mutagen \
    && rm -rf /var/lib/apt/lists/*

# yt-dlp (pinned, pure Python — works on ARM64 and x64).
ARG YTDLP_VERSION=2026.08.19
RUN pip3 install --no-cache-dir --break-system-packages "yt-dlp==${YTDLP_VERSION}" \
    && yt-dlp --version

# Prowlarr self-contained build (pinned, no dotnet needed).
# TARGETARCH is set automatically by BuildKit (amd64/arm64).
# Prowlarr uses x64 instead of amd64 in their release URLs.
ARG PROWLARR_VERSION=2.6.5.5623
ARG TARGETARCH
RUN case "${TARGETARCH}" in \
      amd64) PROWLARR_ARCH=x64 ;; \
      arm64) PROWLARR_ARCH=arm64 ;; \
      *) echo "Unsupported architecture: ${TARGETARCH}" && exit 1 ;; \
    esac \
    && curl -fsSL -o /tmp/prowlarr.tar.gz \
      "https://github.com/Prowlarr/Prowlarr/releases/download/v${PROWLARR_VERSION}/Prowlarr.master.${PROWLARR_VERSION}.linux-core-${PROWLARR_ARCH}.tar.gz" \
    && mkdir -p /opt/prowlarr && tar -xzf /tmp/prowlarr.tar.gz -C /opt/prowlarr \
    && rm /tmp/prowlarr.tar.gz \
    && chmod -R a+rX /opt/prowlarr

# Published CLIs (pinned) + pnpm for profile assembly. dsh gates every
# plugin's @deepseek-ai/dsh-* peers against this runtime version at
# `dsh plugin add` and profile boot, so this pin must equal the stack's peers.
RUN npm i -g --allow-scripts=@deepseek-ai/dsh-subprocess-local,koffi,node-pty,protobufjs \
      @deepseek-ai/dsh@0.2.2-rc.5 pnpm@11.7.0 \
    && npm cache clean --force

# Agent helper runtime: keys.mjs (--no-xmtp) needs only viem.
COPY docker/mausbot/agent.package.json /opt/agent/package.json
RUN cd /opt/agent && npm i --omit=dev --no-audit --no-fund \
    && npm cache clean --force

# Shared key/indexer helpers + MausBot GUI variant scripts/configs.
# Strip CR from shell scripts so Windows checkouts never break shebangs.
COPY docker/keys.mjs docker/setup-indexers.mjs \
     docker/mausbot/entrypoint.sh docker/mausbot/supervisord.conf \
     docker/mausbot/profile.acp.patch.yml \
     docker/mausbot/dsh-acp-wrapper.sh docker/mausbot/acp-stdout-guard.mjs \
     docker/mausbot/no-body-timeout.cjs \
     docker/mausbot/seed-openmausbot.mjs docker/mausbot/mausbot-pair.sh \
     /opt/agent/
RUN sed -i 's/\r$//' \
      /opt/agent/entrypoint.sh \
      /opt/agent/dsh-acp-wrapper.sh /opt/agent/mausbot-pair.sh \
    && chmod +x \
      /opt/agent/entrypoint.sh \
      /opt/agent/dsh-acp-wrapper.sh /opt/agent/mausbot-pair.sh \
    && sh -n /opt/agent/entrypoint.sh \
    && sh -n /opt/agent/dsh-acp-wrapper.sh \
    && sh -n /opt/agent/mausbot-pair.sh \
    && chmod -R a+rX /opt/agent

# Wrap `/usr/local/bin/openmausbot` so `docker exec <container> openmausbot pair`
# drops to `maus` when invoked as root and always targets `/data/openmausbot`.
RUN printf '%s\n' \
      '#!/bin/sh' \
      'set -eu' \
      'export OMB_DATA_DIR="${OMB_DATA_DIR:-/data/openmausbot}"' \
      'export OMB_PORT="${OMB_PORT:-8799}"' \
      'export HOME="/data/openmausbot-home"' \
      'if [ "$(id -u)" = "0" ]; then' \
      '  exec runuser -u maus -- env \' \
      '    "PATH=$PATH" \' \
      '    "HOME=$HOME" \' \
      '    "DSH_HOME=${DSH_HOME:-/data/dsh}" \' \
      '    "OMB_DATA_DIR=$OMB_DATA_DIR" \' \
      '    "OMB_PORT=$OMB_PORT" \' \
      '    "OMB_PUBLIC_URL=${OMB_PUBLIC_URL:-http://localhost:${OMB_PORT}}" \' \
      '    "OMB_CLI_PREFIX=${OMB_CLI_PREFIX:-openmausbot}" \' \
      '    node /app/dist-server/openmausbot.js "$@"' \
      'fi' \
      'exec node /app/dist-server/openmausbot.js "$@"' \
    > /usr/local/bin/openmausbot \
    && chmod 0755 /usr/local/bin/openmausbot \
    && sh -n /usr/local/bin/openmausbot

# Web3 agent stack workspace root (excluding dsh-channel-xmtp — OpenMausBot is
# the communication surface in this image).
COPY package.json pnpm-workspace.yaml tsconfig.base.json .npmrc /opt/stack/
RUN sed -i '/dsh-channel-xmtp/d' /opt/stack/pnpm-workspace.yaml
COPY dsh-wallet/ /opt/stack/dsh-wallet/
COPY dsh-wallet-ethereum/ /opt/stack/dsh-wallet-ethereum/
COPY dsh-wallet-tools/ /opt/stack/dsh-wallet-tools/
COPY dsh-treasury/ /opt/stack/dsh-treasury/
COPY dsh-storage-synapse/ /opt/stack/dsh-storage-synapse/
COPY dsh-arkiv/ /opt/stack/dsh-arkiv/
COPY dsh-erc8004/ /opt/stack/dsh-erc8004/
COPY dsh-royalty-router/ /opt/stack/dsh-royalty-router/
COPY dsh-haven-aol/ /opt/stack/dsh-haven-aol/
COPY dsh-persona/ /opt/stack/dsh-persona/
COPY dsh-tool-prowlarr/ /opt/stack/dsh-tool-prowlarr/
COPY dsh-tool-acquisition/ /opt/stack/dsh-tool-acquisition/
COPY dsh-observatory/ /opt/stack/dsh-observatory/
COPY dsh-exactly-once/ /opt/stack/dsh-exactly-once/
COPY dsh-agent-herald/ /opt/stack/dsh-agent-herald/

# Pinned sibling SDK sources (keep in sync with docker/Dockerfile and ci.yml).
ARG HAVEN_AOL_REF=2fc5bbfba170d7665b902fefb1ed8605ae14535c
RUN git init -q /opt/haven-aol && cd /opt/haven-aol \
    && git remote add origin https://github.com/Haven-hvn/haven-aol.git \
    && git fetch -q --depth 1 origin ${HAVEN_AOL_REF} && git checkout -q FETCH_HEAD \
    && rm -rf .git \
    && cd packages/typescript && npm ci --no-audit --no-fund --ignore-scripts \
    && npm run build && npm prune --omit=dev \
    && npm cache clean --force \
    && chmod -R a+rX /opt/haven-aol

ARG ROYALTY_REF=5f8b8b79f22e4d10508059c56874ee409d26b581
RUN git init -q /opt/mint-glue-graduate && cd /opt/mint-glue-graduate \
    && git remote add origin https://github.com/Haven-hvn/mint-glue-graduate.git \
    && git fetch -q --depth 1 origin ${ROYALTY_REF} && git checkout -q FETCH_HEAD \
    && rm -rf .git \
    && cd sdk && npm ci --no-audit --no-fund --ignore-scripts \
    && npm run build && npm prune --omit=dev \
    && npm cache clean --force \
    && chmod -R a+rX /opt/mint-glue-graduate

# Build the stack in-image. Do NOT `pnpm prune --prod` (peers live in devDeps).
# pnpm-workspace.yaml sets verifyDepsBeforeRun: false and ignoreScripts: true,
# so `pnpm -r build` cannot spawn an implicit install that re-runs `prepare`
# (tsdown) under QEMU. Ensure every .bin shim is executable before the explicit
# build too: emulated arm64 can skip pnpm's bin chmod and then fail with
# `tsdown: Permission denied` (exit 126).
RUN cd /opt/stack && pnpm install --no-frozen-lockfile --ignore-scripts \
    && (find /opt/stack -path '*/node_modules/.bin/*' -type l -exec chmod +x {} + 2>/dev/null || true) \
    && pnpm -r build \
    && chmod -R a+rX /opt/stack

# Build the `acp` profile skeleton in `/opt/dsh-skel`:
# `@deepseek-ai/dsh-acp-app` + all 15 web3 plugins (driven by OpenMausBot via
# `/opt/agent/dsh-acp-wrapper.sh`, zero XMTP dependencies).
RUN DSH_HOME=/opt/dsh-skel dsh plugin --profile acp add \
      /opt/stack/dsh-exactly-once \
      /opt/stack/dsh-wallet /opt/stack/dsh-wallet-ethereum \
      /opt/stack/dsh-wallet-tools /opt/stack/dsh-treasury \
      /opt/stack/dsh-storage-synapse \
      /opt/stack/dsh-arkiv /opt/stack/dsh-erc8004 \
      /opt/stack/dsh-royalty-router /opt/stack/dsh-haven-aol \
      /opt/stack/dsh-persona /opt/stack/dsh-tool-prowlarr \
      /opt/stack/dsh-tool-acquisition /opt/stack/dsh-observatory \
      /opt/stack/dsh-agent-herald \
    && DSH_HOME=/opt/dsh-skel dsh --profile acp --dump-default-config > /dev/null \
    && DSH_HOME=/opt/dsh-skel MODEL_BASE_URL=https://example.invalid/v1 MODEL_ID=test-model MODEL_API_KEY=dummy PROWLARR_API_KEY=dummy \
       dsh --profile acp --patch /opt/agent/profile.acp.patch.yml --dump-config > /dev/null \
    && DSH_HOME=/opt/dsh-skel PROWLARR_API_KEY=dummy \
       dsh --profile acp --patch /opt/agent/profile.acp.patch.yml --dump-config > /dev/null \
    && node --input-type=module -e "await import('/opt/stack/dsh-wallet/lib/index.js'); await import('/opt/stack/dsh-tool-acquisition/lib/index.js'); await import('/opt/stack/dsh-observatory/lib/index.js'); await import('/opt/stack/dsh-exactly-once/lib/index.js'); await import('/opt/stack/dsh-agent-herald/lib/index.js'); await import('/opt/agent/seed-openmausbot.mjs'); await import('/opt/agent/acp-stdout-guard.mjs'); console.log('mausbot stack import gate: OK')" \
    && node --require /opt/agent/no-body-timeout.cjs \
       -e "console.log('body-timeout preload gate: OK')" \
    && { dsh --version; \
         sha256sum /opt/dsh-skel/profiles/acp/package.json \
                   /opt/stack/pnpm-lock.yaml; \
         [ ! -f /opt/dsh-skel/profiles/acp/pnpm-lock.yaml ] || sha256sum /opt/dsh-skel/profiles/acp/pnpm-lock.yaml; \
       } | sha256sum | cut -d' ' -f1 > /opt/dsh-skel/.skel-id \
    && echo "mausbot profile skeleton id: $(cat /opt/dsh-skel/.skel-id)" \
    && chmod -R a+rX /opt/dsh-skel \
    && cp -a /opt/dsh-skel /tmp/maus-skel-test \
    && for link in /tmp/maus-skel-test/profiles/acp/node_modules/dsh-*; do \
         if [ -L "$link" ]; then ln -sfn "/opt/stack/$(basename "$link")" "$link"; fi; \
       done \
    && chown -R maus:maus /tmp/maus-skel-test \
    && runuser -u maus -- env "PATH=$PATH" DSH_HOME=/tmp/maus-skel-test \
       MODEL_BASE_URL=https://example.invalid/v1 MODEL_ID=test-model MODEL_API_KEY=dummy PROWLARR_API_KEY=dummy \
       dsh --profile acp --patch /opt/agent/profile.acp.patch.yml --dump-config > /dev/null \
    && runuser -u maus -- env "PATH=$PATH" DSH_HOME=/tmp/maus-skel-test PROWLARR_API_KEY=dummy \
       dsh --profile acp --patch /opt/agent/profile.acp.patch.yml --dump-config > /dev/null \
    && runuser -u maus -- env "PATH=$PATH" node --input-type=module -e "await import('/opt/stack/dsh-wallet/lib/index.js'); await import('/opt/stack/dsh-tool-acquisition/lib/index.js'); await import('/opt/stack/dsh-observatory/lib/index.js'); await import('/opt/stack/dsh-agent-herald/lib/index.js'); console.log('maus non-root import gate: OK')" \
    && rm -rf /tmp/maus-skel-test

ENV HOME=/data/openmausbot-home \
    NODE_ENV=production \
    OMB_DATA_DIR=/data/openmausbot \
    OMB_PORT=8799 \
    OMB_WEBHOOK_PORT=8800 \
    OMB_CLI_PREFIX="openmausbot" \
    DSH_HOME=/data/dsh

EXPOSE 8799 8787
VOLUME /data

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -sf http://127.0.0.1:8799/api/health | grep -q openmausbot || exit 1

ENTRYPOINT ["/usr/bin/tini", "-s", "--", "/opt/agent/entrypoint.sh"]
CMD []

LABEL org.opencontainers.image.title="dsh web3 agent + OpenMausBot GUI (all-in-one)" \
      org.opencontainers.image.description="OpenMausBot GUI + DeepSeek Harness + web3 agent stack + Prowlarr/qBittorrent/media binaries in a single container."
