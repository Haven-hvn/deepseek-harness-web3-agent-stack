{
  "name": "dsh-observatory",
  "description": "In-process ledger and live snapshot for the read-only agent dashboard",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./snapshot": {
      "types": "./lib/snapshot.d.ts",
      "default": "./lib/snapshot.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "src", "cordis.patch.yml"],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  }
}
