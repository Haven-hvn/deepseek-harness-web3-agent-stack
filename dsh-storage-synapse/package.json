{
  "name": "dsh-storage-synapse",
  "description": "Synapse pinning for DeepSeek Harness: ctx.synapse (store/retrieve/pin over a Synapse/IPFS node) plus synapse_pin and synapse_pin_status agent tools \u2014 every request authenticated by a per-operation dsh-wallet signature, never a stored storage key",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./synapse": {
      "types": "./lib/synapse.d.ts",
      "default": "./lib/synapse.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "==3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "==4.0.1",
    "@deepseek-ai/dsh-invariants": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "==0.1.0-rc.7",
    "dsh-wallet": "==0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "==4.0.1",
    "@deepseek-ai/dsh-credentials": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "==0.1.0-rc.7",
    "dsh-wallet": "workspace:==0.1.0",
    "tsdown": "==0.22.14",
    "typescript": "==7.0.2",
    "vitest": "==4.1.11"
  }
}
