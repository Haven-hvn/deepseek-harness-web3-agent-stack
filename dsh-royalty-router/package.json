{
  "name": "dsh-royalty-router",
  "description": "mint.club graduation advisor + launcher for DeepSeek Harness: rr_advise (model-backed launch params), rr_venue (curve-vs-pool quotes), rr_build (launch dry-run), rr_launch, rr_sweep, rr_heartbeat over @royalty-router/sdk — reads are free, execute tools sign per operation through ctx.wallet",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@royalty-router/sdk": "file:../../mint-glue-graduate/sdk",
    "viem": "2.58.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "dsh-exactly-once": "workspace:=0.1.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
