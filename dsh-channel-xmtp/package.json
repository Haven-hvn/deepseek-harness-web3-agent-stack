{
  "name": "dsh-channel-xmtp",
  "description": "XMTP channel for DeepSeek Harness: direct agent↔user messaging over the XMTP network — Ethereum identity signed per-operation through dsh-wallet, one dsh agent per conversation observed as a session, assistant output (replies and background-turn results) sent back to the conversation",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./xmtp": {
      "types": "./lib/xmtp.d.ts",
      "default": "./lib/xmtp.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@xmtp/node-sdk": "6.1.0",
    "dsh-wallet": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@xmtp/node-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "=0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "=0.2.1-alpha.1",
    "dsh-wallet": "workspace:=0.1.0",
    "tsdown": "=0.23.0",
    "typescript": "=7.0.2",
    "vitest": "=5.0.2"
  }
}
