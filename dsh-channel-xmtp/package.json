{
  "name": "dsh-channel-xmtp",
  "description": "XMTP channel for DeepSeek Harness: direct agent\u2194user messaging over the XMTP network \u2014 Ethereum identity signed per-operation through dsh-wallet, one dsh agent per conversation, assistant replies sent back to the conversation",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./xmtp": {
      "types": "./lib/xmtp.d.ts",
      "default": "./lib/xmtp.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "==3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "==4.0.1",
    "@deepseek-ai/dsh-agent": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "==0.1.0-rc.7",
    "@xmtp/node-sdk": "==6.1.0",
    "dsh-wallet": "==0.1.0"
  },
  "peerDependenciesMeta": {
    "@xmtp/node-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "==4.0.1",
    "@deepseek-ai/dsh-agent": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "==0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "==0.1.0-rc.7",
    "dsh-wallet": "workspace:==0.1.0",
    "tsdown": "==0.22.14",
    "typescript": "==7.0.2",
    "vitest": "==4.1.11"
  }
}
