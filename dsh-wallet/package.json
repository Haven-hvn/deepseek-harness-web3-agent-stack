{
  "name": "dsh-wallet",
  "description": "Wallet capability seam for DeepSeek Harness (ctx.wallet): named wallets over pluggable chain adapters, with secrets resolved through ctx.credentials at each operation \u2014 configuration carries credential references, never keys",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
